{
  "description": "ABBD hooks. Each does nothing unless /abbd-mode turned the mode on for the session.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "abbd",
            "args": [
              "hook",
              "SessionStart"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "abbd",
            "args": [
              "hook",
              "UserPromptSubmit"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "abbd",
            "args": [
              "hook",
              "PreToolUse"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "abbd",
            "args": [
              "hook",
              "PostToolUse"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "abbd",
            "args": [
              "hook",
              "Stop"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
