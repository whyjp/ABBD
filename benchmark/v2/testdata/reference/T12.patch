+
+func (s *Server) handleList(w http.ResponseWriter, r *http.Request) {
+	source := r.URL.Query().Get("source")
+	if source == "" {
+		writeError(w, http.StatusBadRequest, "query parameter source is required")
+		return
+	}
+	writeJSON(w, http.StatusOK, map[string][]heartbeat.Heartbeat{"heartbeats": s.store.BySource(source)})
+}
diff --git a/internal/storage/storage.go b/internal/storage/storage.go
index a7ae2b9..a8927e8 100644
--- a/internal/storage/storage.go
+++ b/internal/storage/storage.go
@@ -2,6 +2,7 @@ package storage
 
 import (
 	"context"
+	"sort"
 	"sync"
 
 	"example.com/heartbeat/internal/heartbeat"
@@ -58,3 +59,17 @@ func (w *Writer) Delete(id string) bool {
 	delete(w.rows, key)
 	return ok
 }
+
+// BySource returns the stored heartbeats from source sorted by id, never nil.
+func (w *Writer) BySource(source string) []heartbeat.Heartbeat {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	out := []heartbeat.Heartbeat{}
+	for _, h := range w.rows {
+		if h.Source == source {
+			out = append(out, h)
+		}
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].ID < out[j].ID })
+	return out
+}
