+
+func TestWriterBySource(t *testing.T) {
+	w := NewWriter("memory://")
+	for _, id := range []string{"b", "a"} {
+		if err := w.Save(context.Background(), heartbeat.Heartbeat{ID: id, Source: "node-1", At: time.Unix(1, 0)}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	got := w.BySource("node-1")
+	if len(got) != 2 || got[0].ID != "a" || len(w.BySource("none")) != 0 {
+		t.Fatalf("BySource = %+v", got)
+	}
+}
