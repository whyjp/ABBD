+
+// handlePostHeartbeat echoes a load-test heartbeat with 201 like any other, but storage drops it.
+func (s *Server) handlePostHeartbeat(w http.ResponseWriter, r *http.Request) {
+	data, ok := readBody(w, r)
+	if !ok {
+		return
+	}
+	h, err := heartbeat.Parse(data)
+	if err == nil {
+		err = heartbeat.Validate(h)
+	}
+	if err != nil {
+		writeError(w, http.StatusBadRequest, err.Error())
+		return
+	}
+	if err := s.store.Save(r.Context(), h); err != nil {
+		writeError(w, http.StatusServiceUnavailable, err.Error())
+		return
+	}
+	writeJSON(w, http.StatusCreated, h)
+}
