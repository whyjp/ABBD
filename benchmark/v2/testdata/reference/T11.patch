+
+func TestPostHeartbeat(t *testing.T) {
+	store := storage.NewWriter("memory://")
+	srv := NewServer(NewKafkaWriter(nil), store)
+	for body, want := range map[string]int{
+		`{"id":"p","source":"node-1","at":"2026-01-01T00:00:00Z"}`: http.StatusCreated,
+		`{"id":"q","source":"test","at":"2026-01-01T00:00:00Z"}`:   http.StatusCreated,
+		`{"id":"r"}`: http.StatusBadRequest,
+	} {
+		rec := httptest.NewRecorder()
+		srv.ServeHTTP(rec, httptest.NewRequest(http.MethodPost, "/heartbeats", strings.NewReader(body)))
+		if rec.Code != want {
+			t.Errorf("POST %s = %d, want %d", body, rec.Code, want)
+		}
+	}
+	if store.Count() != 1 {
+		t.Fatalf("stored %d, want 1 (load-test heartbeat dropped)", store.Count())
+	}
+}
