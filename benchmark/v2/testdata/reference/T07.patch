@@ -64,3 +64,13 @@ func TestPostMessageRejectsOversizedBody(t *testing.T) {
 		t.Fatalf("status = %d, want 413", rec.Code)
 	}
 }
+
+func TestImport(t *testing.T) {
+	store := storage.NewWriter("memory://")
+	rec := httptest.NewRecorder()
+	body := `[{"id":"a","source":"node-1","at":"2026-01-01T00:00:00Z"},{"id":"b"}]`
+	NewServer(NewKafkaWriter(nil), store).ServeHTTP(rec, httptest.NewRequest(http.MethodPost, "/heartbeats/import", strings.NewReader(body)))
+	if rec.Code != http.StatusOK || !strings.Contains(rec.Body.String(), `"imported":1`) || store.Count() != 1 {
+		t.Fatalf("import = %d %s, stored %d", rec.Code, rec.Body.String(), store.Count())
+	}
+}
