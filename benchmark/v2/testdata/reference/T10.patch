+
+func TestWriterDelete(t *testing.T) {
+	w := NewWriter("memory://")
+	if err := w.Save(context.Background(), heartbeat.Heartbeat{ID: "Ab", Source: "node-1", At: time.Unix(1, 0)}); err != nil {
+		t.Fatal(err)
+	}
+	if !w.Delete("aB") || w.Delete("ab") || w.Count() != 0 {
+		t.Fatalf("delete sequence wrong, count %d", w.Count())
+	}
+}
