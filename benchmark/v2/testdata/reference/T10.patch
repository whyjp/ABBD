 }
 
@@ -140,3 +141,11 @@ func (s *Server) handleGet(w http.ResponseWriter, r *http.Request) {
 	}
 	writeJSON(w, http.StatusOK, h)
 }
+
+func (s *Server) handleDelete(w http.ResponseWriter, r *http.Request) {
+	if !s.store.Delete(r.PathValue("id")) {
+		writeError(w, http.StatusNotFound, "heartbeat not found")
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
diff --git a/internal/storage/storage.go b/internal/storage/storage.go
index 346dea4..a7ae2b9 100644
--- a/internal/storage/storage.go
+++ b/internal/storage/storage.go
@@ -49,3 +49,12 @@ func (w *Writer) Get(id string) (heartbeat.Heartbeat, bool) {
 	h, ok := w.rows[heartbeat.Key(id)]
 	return h, ok
 }
+
+func (w *Writer) Delete(id string) bool {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	key := heartbeat.Key(id)
+	_, ok := w.rows[key]
+	delete(w.rows, key)
+	return ok
+}
