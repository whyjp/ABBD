+
+func TestPostMessageRejectsOversizedBody(t *testing.T) {
+	rec := httptest.NewRecorder()
+	body := `{"key":"k","body":"` + strings.Repeat("x", 2000) + `"}`
+	NewServer(NewKafkaWriter(nil), nil).ServeHTTP(rec, httptest.NewRequest(http.MethodPost, "/messages", strings.NewReader(body)))
+	if rec.Code != http.StatusRequestEntityTooLarge {
+		t.Fatalf("status = %d, want 413", rec.Code)
+	}
+}
