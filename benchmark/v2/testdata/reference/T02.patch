+
+func TestWriterDropsLoadTestHeartbeats(t *testing.T) {
+	w := NewWriter("memory://")
+	if err := w.Save(context.Background(), heartbeat.Heartbeat{ID: "a", Source: heartbeat.LoadTestSource, At: time.Unix(1, 0)}); err != nil {
+		t.Fatal(err)
+	}
+	if w.Count() != 0 {
+		t.Fatalf("count = %d, want 0", w.Count())
+	}
