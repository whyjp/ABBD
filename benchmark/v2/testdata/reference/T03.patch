+
+func TestWriterIDsAreCaseInsensitive(t *testing.T) {
+	w := NewWriter("memory://")
+	for _, id := range []string{"ABC", "abc"} {
+		if err := w.Save(context.Background(), heartbeat.Heartbeat{ID: id, Source: "node-1", At: time.Unix(1, 0)}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if w.Count() != 1 {
+		t.Fatalf("count = %d, want 1", w.Count())
+	}
+}
