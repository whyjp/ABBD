+package replay
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"example.com/heartbeat/internal/storage"
+)
+
+func TestFileSkipsBadLines(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "dump.jsonl")
+	data := "{\"id\":\"a\",\"source\":\"node-1\",\"at\":\"2026-01-01T00:00:00Z\"}\nnot json\n\n{\"id\":\"b\"}\n"
+	if err := os.WriteFile(path, []byte(data), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	store := storage.NewWriter("memory://")
+	n, err := File(context.Background(), path, store)
+	if err != nil || n != 1 || store.Count() != 1 {
+		t.Fatalf("File = %d, %v; stored %d", n, err, store.Count())
+	}
+}
