+package main
+
+import (
+	"context"
+	"fmt"
+	"log"
+	"os"
+
+	"example.com/heartbeat/internal/replay"
+	"example.com/heartbeat/internal/storage"
+)
+
+func main() {
+	if len(os.Args) != 2 {
+		fmt.Fprintln(os.Stderr, "usage: heartbeat-replay <dump.jsonl>")
+		os.Exit(2)
+	}
+	n, err := replay.File(context.Background(), os.Args[1], storage.NewWriter(os.Getenv("HEARTBEAT_DB_URL")))
+	if err != nil {
+		log.Fatal(err)
+	}
+	fmt.Printf("replayed %d heartbeats\n", n)
+}
