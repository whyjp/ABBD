+// Package replay re-ingests a JSON Lines dump of heartbeats into a store.
+package replay
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"os"
+
+	"example.com/heartbeat/internal/heartbeat"
+)
+
+// File saves every line of path that parses and validates, and returns how many it saved.
+func File(ctx context.Context, path string, store heartbeat.Store) (int, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return 0, err
+	}
+	defer f.Close()
+	saved := 0
+	sc := bufio.NewScanner(f)
+	for sc.Scan() {
+		line := bytes.TrimSpace(sc.Bytes())
+		if len(line) == 0 {
+			continue
+		}
+		h, err := heartbeat.Parse(line)
+		if err != nil || heartbeat.Validate(h) != nil {
+			continue
+		}
+		if err := store.Save(ctx, h); err != nil {
+			return saved, err
+		}
+		saved++
+	}
+	return saved, sc.Err()
+}
