diff --git a/internal/api/api.go b/internal/api/api.go
index c39099a..4a4d658 100644
--- a/internal/api/api.go
+++ b/internal/api/api.go
@@ -5,28 +5,45 @@ import (
 	"net/http"
 
 	"example.com/heartbeat/internal/kafka"
+	"example.com/heartbeat/internal/storage"
 )
 
 const TopicMessages = "message-events"
 
 type Server struct {
 	writer kafka.Writer
+	store  *storage.Writer
 	mux    *http.ServeMux
+	routes []string
 }
 
 func NewKafkaWriter(brokers []string) kafka.Writer {
 	return kafka.NewWriter(kafka.WriterConfig{Brokers: brokers, Topic: TopicMessages})
 }
 
-func NewServer(w kafka.Writer) *Server {
-	s := &Server{writer: w, mux: http.NewServeMux()}
-	s.mux.HandleFunc("POST /messages", s.handlePostMessage)
-	s.mux.HandleFunc("GET /health", s.handleHealth)
+func NewServer(w kafka.Writer, store *storage.Writer) *Server {
+	s := &Server{writer: w, store: store, mux: http.NewServeMux()}
+	s.handle("POST /messages", s.handlePostMessage)
+	s.handle("GET /health", s.handleHealth)
+	s.handle("GET /heartbeats/count", s.handleCount)
+	s.handle("GET /routes", s.handleRoutes)
 	return s
 }
 
+// handle is the only way to register a route, so GET /routes cannot drift from the mux.
+func (s *Server) handle(pattern string, h http.HandlerFunc) {
+	s.mux.HandleFunc(pattern, h)
+	s.routes = append(s.routes, pattern)
+}
+
 func (s *Server) ServeHTTP(w http.ResponseWriter, r *http.Request) { s.mux.ServeHTTP(w, r) }
 
+func writeJSON(w http.ResponseWriter, status int, v any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	json.NewEncoder(w).Encode(v)
+}
+
 type message struct {
 	Key  string `json:"key"`
 	Body string `json:"body"`
@@ -48,3 +65,11 @@ func (s *Server) handlePostMessage(w http.ResponseWriter, r *http.Request) {
 func (s *Server) handleHealth(w http.ResponseWriter, _ *http.Request) {
 	w.Write([]byte("ok"))
 }
+
+func (s *Server) handleCount(w http.ResponseWriter, _ *http.Request) {
+	writeJSON(w, http.StatusOK, map[string]int{"count": s.store.Count()})
+}
+
+func (s *Server) handleRoutes(w http.ResponseWriter, _ *http.Request) {
+	writeJSON(w, http.StatusOK, map[string][]string{"routes": s.routes})
+}
