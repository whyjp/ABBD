diff --git a/internal/dedupe/dedupe.go b/internal/dedupe/dedupe.go
new file mode 100644
index 0000000..09479f7
--- /dev/null
+++ b/internal/dedupe/dedupe.go
@@ -0,0 +1,29 @@
+// Package dedupe tracks which ids have already been processed.
+package dedupe
+
+import "sync"
+
+type Set struct {
+	mu   sync.Mutex
+	seen map[string]struct{}
+}
+
+func New() *Set { return &Set{seen: map[string]struct{}{}} }
+
+// FirstSeen reports whether id is new, and records it.
+func (s *Set) FirstSeen(id string) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.seen[id]; ok {
+		return false
+	}
+	s.seen[id] = struct{}{}
+	return true
+}
+
+// Forget removes id so a later FirstSeen reports it as new again.
+func (s *Set) Forget(id string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	delete(s.seen, id)
+}
