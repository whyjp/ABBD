diff --git a/internal/heartbeat/dedupe.go b/internal/heartbeat/dedupe.go
index be71134..2d8224e 100644
--- a/internal/heartbeat/dedupe.go
+++ b/internal/heartbeat/dedupe.go
@@ -1,14 +1,26 @@
 package heartbeat
 
+import "sync"
+
 type dedupe struct {
+	mu   sync.Mutex
 	seen map[string]struct{}
 }
 
 func newDedupe() *dedupe { return &dedupe{seen: map[string]struct{}{}} }
 
-func (d *dedupe) has(id string) bool {
-	_, ok := d.seen[id]
-	return ok
+func (d *dedupe) firstSeen(id string) bool {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if _, ok := d.seen[id]; ok {
+		return false
+	}
+	d.seen[id] = struct{}{}
+	return true
 }
 
-func (d *dedupe) add(id string) { d.seen[id] = struct{}{} }
+func (d *dedupe) forget(id string) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	delete(d.seen, id)
+}
