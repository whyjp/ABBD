+const insertHeartbeat = "INSERT INTO heartbeats (id, source, at, version) VALUES ($1, $2, $3, $4) ON CONFLICT (id) DO NOTHING"
 
 // Writer keeps rows in memory. Statements records what a SQL driver would have executed.
 type Writer struct {
@@ -39,3 +39,10 @@ func (w *Writer) Count() int {
 	defer w.mu.Unlock()
