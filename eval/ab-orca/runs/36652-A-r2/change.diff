+      lastCommittedRef.current = committed
+      setDraft(committed)
+    }
+  }, [committed])
+  return [
+    draft,
+    (next) => {
+      lastCommittedRef.current = next
+      setDraft(next)
+      commit(next)
+    }
+  ]
