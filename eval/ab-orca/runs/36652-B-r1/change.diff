index 00000000..96954d5f
--- /dev/null
+++ b/src/renderer/src/components/settings/setting-text-draft.ts
@@ -0,0 +1,22 @@
+import { useEffect, useRef, useState } from 'react'
+
+/** Local drafts preserve caret/fast typing through async IPC; adopt external reloads but ignore delayed echoes of our own edits. */
+export function useSettingTextDraft(
+  committed: string,
+  commit: (next: string) => void
+): [string, (next: string) => void] {
+  const [draft, setDraft] = useState(committed)
+  const lastCommittedRef = useRef(committed)
+  useEffect(() => {
+    if (committed !== lastCommittedRef.current) {
+      lastCommittedRef.current = committed
+      setDraft(committed)
+    }
+  }, [committed])
+  const change = (next: string): void => {
+    lastCommittedRef.current = next
+    setDraft(next)
+    commit(next)
+  }
+  return [draft, change]
+}
