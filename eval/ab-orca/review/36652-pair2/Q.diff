diff --git a/src/main/ipc/worktree-branch-name.test.ts b/src/main/ipc/worktree-branch-name.test.ts
new file mode 100644
index 00000000..b978c5ba
--- /dev/null
+++ b/src/main/ipc/worktree-branch-name.test.ts
@@ -0,0 +1,65 @@
+import { describe, expect, it } from 'vitest'
+import { getBranchLeaf } from '../../shared/branch-prefix'
+import { computeValidatedBranchName, getConfiguredBranchPrefix } from './worktree-branch-name'
+
+describe('computeValidatedBranchName separator', () => {
+  it('joins the prefix with the configured separator', () => {
+    expect(
+      computeValidatedBranchName(
+        'feat-login-form',
+        { branchPrefix: 'custom', branchPrefixCustom: 'jd', branchPrefixSeparator: '-' },
+        null
+      )
+    ).toBe('jd-feat-login-form')
+  })
+
+  it('keeps the slash join when the separator is missing or blank', () => {
+    expect(computeValidatedBranchName('feat', { branchPrefix: 'git-username' }, 'jdoe')).toBe(
+      'jdoe/feat'
+    )
+    expect(
+      computeValidatedBranchName(
+        'feat',
+        { branchPrefix: 'custom', branchPrefixCustom: 'team', branchPrefixSeparator: '  ' },
+        null
+      )
+    ).toBe('team/feat')
+  })
+
+  it('rejects a separator git would reject', () => {
+    for (const separator of ['~', '- -', '//', '..', '/.']) {
+      expect(() =>
+        computeValidatedBranchName(
+          'feat',
+          { branchPrefix: 'custom', branchPrefixCustom: 'jd', branchPrefixSeparator: separator },
+          null
+        )
+      ).toThrow(/separator/)
+    }
+  })
+
+  it('ignores the separator when no prefix applies', () => {
+    expect(
+      computeValidatedBranchName('feat', { branchPrefix: 'none', branchPrefixSeparator: '~' }, null)
+    ).toBe('feat')
+  })
+})
+
+describe('getBranchLeaf', () => {
+  const settings = {
+    branchPrefix: 'custom',
+    branchPrefixCustom: 'jd',
+    branchPrefixSeparator: '-'
+  } as const
+
+  it('recovers the leaf of a branch built with a dash separator', () => {
+    const branch = computeValidatedBranchName('crab-2', settings, null)
+    expect(getBranchLeaf(branch, getConfiguredBranchPrefix(settings, null), '-')).toBe('crab-2')
+  })
+
+  it('falls back to the last path segment for branches made under other settings', () => {
+    expect(getBranchLeaf('jd/crab', 'jd', '-')).toBe('crab')
+    expect(getBranchLeaf('team/frontend/crab', 'team/frontend', undefined)).toBe('crab')
+    expect(getBranchLeaf('crab', null, undefined)).toBe('crab')
+  })
+})
