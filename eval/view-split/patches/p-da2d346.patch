+func TestAReaderMendsAHumansColumnWhoseUnitLeft(t *testing.T) {
+	p := notesProject(t)
+	p.code("audit/log.go", "package audit\n\nfunc Log() {}\n")
+	p.extract(auditTopo)
+	p.resync()
+	p.table(0, "USER_STATED", auditTable(), "--source", "conversation 2026-11-04")
